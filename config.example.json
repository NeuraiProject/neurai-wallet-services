{
  "service_id": "neurai-testnet-wallet-service",
  "network": "testnet",
  "genesis_hash": "0000008b384aeffecdab182575dc4e86c9f07f90318c65088532660ed9a8a021",
  "trusted_proxy_ips": ["127.0.0.1", "::1", "::ffff:127.0.0.1"],

  "depin": {
    "rate_limit": 60,
    "ban_minutes": 10
  },

  "wss": {
    "enabled": false,
    "host": "0.0.0.0",
    "port": 19020,
    "path": "/push",

    "tls_enabled": false,
    "ssl_cert": "./certs/push.crt",
    "ssl_key": "./certs/push.key",

    "auth_transport": "sec-websocket-protocol",
    "auth_token": "change-this-token",

    "max_sessions": 5000,
    "max_subscriptions_per_session": 200,
    "max_new_connections_per_second": 50,
    "history_page_limit": 100,
    "utxo_page_limit": 1000,
    "bulk_subscribe_limit": 200,
    "reorg_invalidate_depth": 120,
    "keepalive_interval_ms": 25000,
    "keepalive_timeout_ms": 10000,
    "send_initial_state": true,

    "zmq_enabled": true,
    "zmq_endpoint": "tcp://neuraid:28332",
    "zmq_sequence_enabled": false,
    "zmq_watchdog_ms": 300000,
    "poll_interval_ms": 5000,
    "mempool_interval_ms": 3000
  },
  "http": {
    "enabled": false,
    "serve_www": true,
    "heading": "Neurai RPC",
    "environment": "Neurai Testnet",
    "endpoint": "https://rpc-test.neurai.org/rpc",
    "concurrency": 4,
    "max_requests_per_second": 100,
    "max_requests_per_second_per_ip": 20,
    "max_queue_size": 500,
    "rate_limiter_ttl_ms": 300000,
    "max_rate_limiter_ips": 10000,
    "extra_methods": [],
    "clients": [],
    "host": "0.0.0.0",
    "port": 19020,
    "tls_enabled": false,
    "tip_poll_interval_ms": 1000
  },
  "nodes": [
    {
      "name": "Local Neurai testnet node (DePIN protocol 2 on the RPC port)",
      "username": "your_rpc_username",
      "password": "your_rpc_password",
      "neurai_url": "http://localhost:19101"
    },
    {
      "name": "Remote node",
      "username": "remote_user",
      "password": "remote_pass",
      "neurai_url": "http://remote-server.com:19001"
    }
  ]
}
