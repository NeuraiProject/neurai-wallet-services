# Template for docker/testnet/.env — copy it next to docker-compose.yml:
#     cp .env.example .env
# .env is ignored by git, so your values survive a `git pull`; this template is
# what gets updated when a new variable appears. Every value has the same
# default in docker-compose.yml, so the stack also starts without a .env.
# Anything not listed here (indexes, ZMQ wiring, paths, healthchecks) is
# structural and lives in docker-compose.yml on purpose.

# ── Node build ──────────────────────────────────────────────────────────────
# Branch of NeuraiProject/Neurai compiled into the testnet node image. Only
# DePIN-Test serves DePIN messaging protocol 2.
NODE_BRANCH=DePIN-Test
# Exact commit of NODE_BRANCH to build: reviewed C6-capable testnet node with
# the database read fixes (asset and restricted-asset lists and gettxoutsetinfo
# flush at most once per chain state, no cs_main held through their scans)
# (genesis 0000008b384aeffecdab182575dc4e86c9f07f90318c65088532660ed9a8a021).
# It must belong to NODE_BRANCH. Changing it is what makes
# `docker compose up -d --build` compile new node source; with the branch alone
# Docker reuses its cached clone. Empty = branch head at the first build.
NODE_SOURCE_COMMIT=1e325225c65a1de4905147062fed1dd25d9d61c6

# ── Node RPC ────────────────────────────────────────────────────────────────
# Used by neuraid (rpcuser/rpcpassword/rpcport in the generated neurai.conf)
# AND by the service's upstream connection (NEURAI_NODE_URL is built from
# NODE_RPC_PORT), so the two can never drift apart. The RPC port is never
# published on the host. Note that neurai.conf is regenerated by the node's
# entrypoint on every start, so a change here applies on the next `up -d`.
NODE_RPC_USER=neurai
NODE_RPC_PASSWORD=changeme
NODE_RPC_PORT=19101

# ── DePIN messaging (protocol 2, served on the RPC port) ────────────────────
# Pool root token (a DePIN asset, `&NAME`). The pool key is derived from the
# node's wallet, which docker-compose.yml keeps enabled for that reason:
# dedicated, unencrypted, never funded. Rotating it changes the identity every
# client has pinned — back the wallet up.
NEURAI_DEPIN_TOKEN=&DEPINTESTING
# Per-address quota enforced by the node: challenges issued + messages
# accepted per minute, counting only requests signed by that address.
NEURAI_DEPIN_RATE_LIMIT=20
# Optional dedicated wallet file inside /data (empty = the default wallet).
NEURAI_DEPIN_WALLET=

# ── Service mode ────────────────────────────────────────────────────────────
# true  -> WSS push (/push) and the HTTP API on one port (wallet deployments).
# false -> the HTTP API alone, without the /push WebSocket: no auth token or
#          ZMQ needed; it keeps the port, bind and TLS below.
PROXY_WSS_ENABLED=true

# ── Service listener ────────────────────────────────────────────────────────
# One value drives the port the service listens on inside the container, the
# port published on the host and the nginx snippet in docker-compose.yml.
PROXY_WSS_PORT=19020
# Host interface the port is published on:
#   127.0.0.1 -> loopback only (recommended). Your nginx proxy_passes to
#                http://127.0.0.1:PROXY_WSS_PORT and terminates TLS.
#   0.0.0.0   -> all interfaces, plain ws:// without TLS: anyone could forge
#                X-Forwarded-For. Only behind a firewall, never on the internet.
PROXY_BIND=127.0.0.1
# Shared secret wallets present as `Sec-WebSocket-Protocol: wss, auth.<token>`.
# Testnet-only default: replace it for any deployment reachable from the internet.
PROXY_WSS_AUTH_TOKEN=testnet-wss-token-do-not-use-in-production
# Public URL of the HTTP RPC as clients reach it (behind your nginx/TLS). Shown
# on the web page and returned by GET /settings; it does not change what the
# service listens on.
PROXY_HTTP_ENDPOINT=https://rpc-test.neurai.org/rpc
PROXY_HTTP_MAX_RPS_PER_IP=20

# ── HTTP API: opt-in methods and trusted clients ────────────────────────────
# Read-only methods opened to every client, comma separated. Only
# gettxoutsetinfo, getmininginfo, getconnectioncount and getnettotals are
# accepted; gettxoutsetinfo is slow, so prefer granting it per client.
PROXY_HTTP_EXTRA_METHODS=
# Backends that call /rpc from one address (explorer, faucet, swap): their own
# request budget instead of the per-IP one, ahead of public requests, and
# optional extra methods. A JSON array in single quotes. "key" is the client's
# RPC password (Basic auth) or a Bearer token, at least 16 characters; "ips"
# takes addresses and CIDR ranges instead of, or besides, a key.
#   PROXY_HTTP_CLIENTS='[{"name":"explorer","key":"<long random secret>","max_requests_per_second":200,"extra_methods":["gettxoutsetinfo"]}]'
PROXY_HTTP_CLIENTS='[]'

# ── Time limit for calls to the node ────────────────────────────────────────
# A call that takes longer fails (HTTP 502, WSS 1005) and frees its slot in the
# node queue that HTTP and WSS share. Milliseconds. gettxoutsetinfo gets 600000
# unless the JSON object overrides it, e.g.
#   PROXY_RPC_METHOD_TIMEOUTS_MS='{"gettxoutsetinfo":900000,"getaddressdeltas":60000}'
PROXY_RPC_TIMEOUT_MS=30000
PROXY_RPC_METHOD_TIMEOUTS_MS='{}'

# ── Reverse proxies whose X-Forwarded-For is believed (HTTP and WSS) ────────
# When using Hestia/nginx on the host, add this Compose network's bridge
# gateway (`docker network inspect neurai_net_testnet`), e.g.
# 172.19.0.1,127.0.0.1,::1. The reverse proxy must OVERWRITE the header
# (proxy_set_header X-Forwarded-For $remote_addr), never append to it.
PROXY_TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1

# ── DePIN abuse control by origin IP (shared by HTTP and WSS) ───────────────
# depin* requests allowed per IP and minute (0 disables), and how long an IP
# that went over stays blocked (0 = refuse until the window frees, no ban).
# Mobile wallets often share an IP (carrier NAT): keep the ban short.
PROXY_DEPIN_RATE_LIMIT=60
PROXY_DEPIN_BAN_MINUTES=10

# ── Reads that flush the node's state ───────────────────────────────────────
# A limit for mainnet's v1.0.6 node (see docker/mainnet/.env.example). This
# node flushes those reads at most once per chain state: 0 keeps it off.
PROXY_FLUSHING_READS_PER_SECOND=0

# ── Optional local stats endpoint (GET http://127.0.0.1:<port>/stats) ───────
# Unauthenticated and loopback-only inside the container; never publish it.
PROXY_WSS_STATS_ENABLED=false

# ── Acceptance suite (tests/docker-compose.yml) ─────────────────────────────
# Genesis hello must report; empty skips the chain identity check.
TEST_EXPECTED_GENESIS=0000008b384aeffecdab182575dc4e86c9f07f90318c65088532660ed9a8a021
# Optional funded addresses on the reset testnet for the happy-path tests
# (empty = skipped).
TEST_ADDRESS=
TEST_ASSET_ADDRESS=
TEST_ASSET_NAME=
